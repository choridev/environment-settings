#!/usr/bin/env bash
# The open issues or pull requests involving me, grouped by repository, in fzf.
#
# fzf re-runs its preview on every focus change and caches nothing, so the inline
# pipeline this replaces spent a request per cursor move, and another on every
# revisit. Here everything is fetched before fzf starts and the preview only
# reads a file. gh's search returns bodies but not comment bodies, hence pass two.
set -uo pipefail

prog=${0##*/}
case ${1-} in
    issues) kind=issues; view=issue ;;
    prs)    kind=prs;    view=pr    ;;
    *) printf 'usage: %s issues|prs\n' "$prog" >&2; exit 2 ;;
esac

for cmd in gh fzf jq base64; do
    command -v "$cmd" >/dev/null 2>&1 ||
        { printf '%s: %s is not installed\n' "$prog" "$cmd" >&2; exit 1; }
done

# tmpfs where the session has one, so private repository text never reaches disk.
# mktemp gives the directory mode 700 either way.
cache=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/$prog.XXXXXX") || exit 1
# EXIT alone misses a popup that is closed rather than quit. SIGKILL cannot be
# caught at all, so anything left from one is swept on the next run — and on
# tmpfs it would not outlive the login session anyway.
#
# A day, not an hour: the directory's mtime does not move while a popup is open,
# so a shorter window would let one run delete the cache another is still reading.
trap 'rm -rf "$cache"' EXIT HUP INT TERM
find "${XDG_RUNTIME_DIR:-/tmp}" -maxdepth 1 -name "$prog.??????" \
    ! -path "$cache" -mtime +1 -exec rm -rf {} + 2>/dev/null

# Both fetches take a few seconds together, and fzf shows nothing until it has
# input, so the wait gets narrated. fzf draws on the alternate screen, so these
# lines disappear the moment it opens.
printf '%s: fetching %s…\n' "$prog" "$kind" >&2

gh search "$kind" --involves=@me --state=open --limit 100 \
    --json repository,number,title,updatedAt,body,commentsCount \
    >"$cache/raw.json" || exit 1

# jq's sort_by is stable, so grouping by repository keeps gh's newest-first order
# inside each group. The row index is what the preview resolves via fzf's {n}.
# The body travels base64-encoded to keep this one line per row.
jq -r 'sort_by(.repository.nameWithOwner) | to_entries[] | [
    (.key | tostring),
    .value.repository.nameWithOwner,
    (.value.number | tostring),
    (.value.commentsCount | tostring),
    .value.title,
    (.value.body // "" | @base64)
] | @tsv' "$cache/raw.json" >"$cache/rows.tsv" || exit 1

if [[ ! -s $cache/rows.tsv ]]; then
    printf '%s: nothing open involving you\n' "$prog" >&2
    exit 0
fi

rule=$(printf '%.0s─' {1..78})

# Comments land below a body that is often hundreds of lines long, so the first
# line says whether scrolling the preview is worth it.
while IFS=$'\t' read -r idx repo number comments title body; do
    note=
    [[ $comments -gt 0 ]] && note="  ·  $comments comment(s) below"
    {
        printf '%s #%s%s\n%s\n%s\n\n' "$repo" "$number" "$note" "$title" "$rule"
        printf '%s' "$body" | base64 -d
    } >"$cache/$idx"
done <"$cache/rows.tsv"

# Comment bodies need one request each. Ten at a time, appended to the file the
# preview already points at. This finishes before fzf opens, so there is no
# half-loaded state to show.
awk -F'\t' '$4 > 0 { print $1; print $2; print $3 }' "$cache/rows.tsv" >"$cache/todo"
if [[ -s $cache/todo ]]; then
    printf '%s: %d found, reading %d comment thread(s)…\n' "$prog" \
        "$(wc -l <"$cache/rows.tsv")" "$(($(wc -l <"$cache/todo") / 3))" >&2
    export GH_VIEW=$view CACHE=$cache
    # 'bash -c script name arg…' puts the three xargs arguments at $1..$3.
    xargs -a "$cache/todo" -n3 -P 10 bash -c '
        gh "$GH_VIEW" view "$3" --repo "$2" --json comments \
            --jq ".comments[] | \"\n\n── \(.author.login) ──\n\n\(.body)\"" \
            >>"$CACHE/$1"
    ' gh-picker-comments
fi

awk -F'\t' '{ printf "%-28s %-7s %s\n", $2, $3, $5 }' "$cache/rows.tsv" |
    fzf --reverse \
        --header="$kind involving me  ·  alt-j/k a line, alt-d/u half a page" \
        --bind 'alt-j:preview-down,alt-k:preview-up,alt-d:preview-half-page-down,alt-u:preview-half-page-up' \
        --preview "cat -- '$cache'/{n}" \
        --preview-window=right:55%:wrap
